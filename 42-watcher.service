[Unit]
Description=42 apply online-meeting watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User and paths to match your Pi (default RPi user is "ls" per your SSH).
User=ls
WorkingDirectory=/home/ls/42-meeting-watcher
ExecStart=/home/ls/42-meeting-watcher/.venv/bin/python /home/ls/42-meeting-watcher/watcher.py run
# exit 0  => booked / intentional stop -> do NOT restart
# exit !=0 => crash / transient failure -> restart after a pause
Restart=on-failure
RestartSec=30
StandardOutput=append:/home/ls/42-meeting-watcher/state/watcher.log
StandardError=append:/home/ls/42-meeting-watcher/state/watcher.log

[Install]
WantedBy=multi-user.target
