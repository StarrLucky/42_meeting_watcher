# --- Copy this file to ".env" and fill it in. Keep .env private (chmod 600). ---

# 42 apply credentials (Keycloak login)
EMAIL=you@example.com
PASSWORD=CHANGE_ME

# Which path / step / meeting type to watch
PATH_ID=af85d358-305d-4c7d-91df-7ed74b3ead50
STEP=PISCINE_MEETING
# REMOTE = Online meeting (what you want). Use ON_SITE only for testing.
TARGET_TYPE=REMOTE

# Polling cadence (seconds). Be polite: 60s is plenty; don't hammer the site.
POLL_INTERVAL=60
POLL_JITTER=15

# Set DRY_RUN=1 to detect the slot but NOT send the booking action (safe test).
DRY_RUN=0

# How often (minutes) to check whether 42 redeployed the site — a redeploy can
# rotate the Next-Action booking id, so on change you get a Telegram alert to
# re-capture BOOK_ACTION_ID. 0 disables the periodic check (startup check stays).
BUILD_CHECK_MINUTES=30

# Optional Telegram alerts (create a bot via @BotFather, get your chat id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Advanced (usually leave default) ---
BASE_URL=https://apply.42.tech
SITE_LOCALE=en
HTTP_TIMEOUT=30

# curl_cffi TLS/JA3 impersonation target used to pass Cloudflare.
# Try chrome, chrome124, chrome120, etc. if you ever get 403s.
IMPERSONATE=chrome

# Booking uses a Next.js Server Action. Its hashed id rotates when 42 rebuilds
# the app, but the source function NAME is stable — so by default the watcher
# auto-discovers the current id from the /paths route JS chunk at booking time
# (run `watcher.py discover` to see it). Leave AUTO_DISCOVER_ACTIONS=1.
AUTO_DISCOVER_ACTIONS=1
BOOK_ACTION_NAME=registerToMeeting
CANCEL_ACTION_NAME=delistMeeting
# Fallback ids, used only if auto-discovery fails (or if you set the flag to 0).
BOOK_ACTION_ID=40d11247e4160267d637cc7e938b72b96033964518
CANCEL_ACTION_ID=40dfa9b6351b1482ff9ef246580415230e45575a08
