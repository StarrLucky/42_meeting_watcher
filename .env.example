# --- Copy this file to ".env" and fill it in. Keep .env private (chmod 600). ---

# 42 apply credentials (used only by automated login on YOUR machine)
EMAIL=you@example.com
PASSWORD=CHANGE_ME

# Which path / step / meeting type to watch
PATH_ID=af85d358-305d-4c7d-91df-7ed74b3ead50
STEP=PISCINE_MEETING
# REMOTE = Online meeting (what you want). Use ON_SITE only for testing.
TARGET_TYPE=REMOTE

# Polling cadence (seconds). Be polite: 60s is plenty; don't hammer the site.
POLL_INTERVAL=60
POLL_JITTER=15

# Browser
HEADLESS=1
# On Raspberry Pi OS it's most reliable to use the system Chromium:
#   sudo apt install -y chromium-browser   (or: chromium)
# then set the path below. Leave empty to use Playwright's bundled Chromium.
CHROMIUM_PATH=/usr/bin/chromium-browser

# Set DRY_RUN=1 to detect + locate the button but NOT click confirm (safe test).
DRY_RUN=0

# Optional Telegram alerts (create a bot via @BotFather, get your chat id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Advanced (usually leave default)
BASE_URL=https://apply.42.tech
SITE_LOCALE=en
# CONFIRM_TEXT_REGEX=confirm|validate|valider|book|register|yes|ok
