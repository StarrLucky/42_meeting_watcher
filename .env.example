# --- Copy this file to ".env" and fill it in. Keep .env private (chmod 600). ---

# 42 apply credentials (Keycloak login)
EMAIL=you@example.com
PASSWORD=CHANGE_ME

# Which path / step / meeting type to watch
PATH_ID=af85d358-305d-4c7d-91df-7ed74b3ead50
STEP=PISCINE_MEETING
# REMOTE = Online meeting (what you want). Use ON_SITE only for testing.
TARGET_TYPE=REMOTE

# Polling cadence (seconds). Be polite: 60s is plenty; don't hammer the site.
POLL_INTERVAL=60
POLL_JITTER=15

# Set DRY_RUN=1 to detect the slot but NOT send the booking action (safe test).
DRY_RUN=0

# Optional Telegram alerts (create a bot via @BotFather, get your chat id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Advanced (usually leave default) ---
BASE_URL=https://apply.42.tech
SITE_LOCALE=en
HTTP_TIMEOUT=30

# curl_cffi TLS/JA3 impersonation target used to pass Cloudflare.
# Try chrome, chrome124, chrome120, etc. if you ever get 403s.
IMPERSONATE=chrome

# Next.js Server Action ids for booking / cancelling. STABLE per site
# deployment, but they change when 42 rebuilds the app. If booking starts
# failing with HTTP errors, re-capture them in the browser DevTools:
#   Network -> click a slot -> the POST to /en/paths -> "Next-Action" header.
BOOK_ACTION_ID=40d11247e4160267d637cc7e938b72b96033964518
CANCEL_ACTION_ID=40dfa9b6351b1482ff9ef246580415230e45575a08
